# XiaoPaw v2 Environment Variables
# Copy to .env and fill in your values

# === Agent LLM ===
OPENAI_API_KEY=sk-xxx                    # LLM API Key
BASE_URL=https://api.example.com/v1/     # API Base URL
MODEL=gpt-4                              # 使用的模型名称

# === 信息摘要模型 ===
EXTRACT_API_KEY=sk-xxx                   # 信息摘要 API Key（可与主模型相同）
EXTRACT_BASE_URL=https://api.example.com/v1/
EXTRACT_MODEL=gpt-4-mini                 # 摘要使用的模型

# === Feishu (required for production) ===
FEISHU_APP_ID=cli_xxx                    # 飞书应用 App ID
FEISHU_APP_SECRET=xxx                    # 飞书应用 App Secret

# === Environment ===
XIAOPAW_ENV=dev                          # dev | production

# === pgvector (optional, for memory search) ===
MEMORY_DB_DSN=postgresql://xiaopaw:password@localhost:5432/xiaopaw_memory

# === Langfuse (optional, for observability) ===
TRACE_TO_LANGFUSE=true
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# ⚠️ 必须设置！不设则默认连 cloud.langfuse.com，本地 Dashboard 看不到 trace
LANGFUSE_BASE_URL=http://localhost:3000

# === Embedding (optional, for memory search) ===
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1/
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024

# === Sandbox (optional, for development) ===
SANDBOX_URL=http://localhost:8030/mcp

# === TestAPI (dev mode only) ===
# XIAOPAW_TESTAPI_TOKEN=your-dev-token

# === 百度搜索 ===
BAIDU_API_KEY=bce-v3/ALTAK-xxx